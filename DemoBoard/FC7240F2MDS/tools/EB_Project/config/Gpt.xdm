                    <d:var name="GptFtuGtb" type="BOOLEAN" value="false">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:ref name="GptFtuGtbRef" type="REFERENCE" >
