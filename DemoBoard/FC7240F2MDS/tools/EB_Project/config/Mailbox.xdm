                    <d:var name="MbHwChannel" type="INTEGER" value="1"/>
                    <d:lst name="MbChannelEcucPartitionRef"/>
                    <d:ctr name="MbFreeChannel" type="IDENTIFIABLE">
                      <a:a name="ENABLE" value="true"/>
                      <d:var name="MbChannelAutoDone" type="BOOLEAN" 
