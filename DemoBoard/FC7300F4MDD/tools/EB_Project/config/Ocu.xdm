<?xml version='1.0'?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="Ocu" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="Ocu" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <d:ctr type="MODULE-CONFIGURATION">
              <a:a name="DEF" value="ASPath:/FC7300FXXX/Ocu"/>
              <a:a name="IMPORTER_INFO" value="@REC"/>
              <d:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" 
                     value="VariantPostBuild"/>
              <d:ctr name="OcuConfigSet" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="OcuCountdirection" type="ENUMERATION" 
                       value="OCU_UPCOUNTING">
                  <a:a name="ENABLE" value="true"/>
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:lst name="OcuChannel" type="MAP">
                  <d:ctr name="OcuChannel_0" type="IDENTIFIABLE">
                    <d:var name="OcuChannelId" type="INTEGER" value="0">
                      <a:a name="IMPORTER_INFO">
                        <a:v>@DEF</a:v>
                        <a:v>@CALC</a:v>
                      </a:a>
                    </d:var>
                    <d:var name="OcuAssignedHardwareChannel" type="INTEGER" 
                           value="0">
                      <a:a name="IMPORTER_INFO">
                        <a:v>@CALC</a:v>
                        <a:v>@DEF</a:v>
                      </a:a>
                    </d:var>
                    <d:ref name="OcuHWSpecificSettingsRef" type="REFERENCE" 
                           value="ASPath:/Ocu/Ocu/OcuConfigSet/OcuHWSpecificSettings_0"/>
                    <d:lst name="OcuChannelEcucPartitionRef">
                      <d:ref type="REFERENCE" 
                             value="ASPath:/EcuC/EcuC/EcucPartitionCollection/EcucPartition_0"/>
                    </d:lst>
                    <d:ref name="OcuHardwareChannelref" type="REFERENCE" 
                           value="ASPath:/Ocu/Ocu/OcuConfigSet/OcuFtu_0/OcuFtuChannels_0"/>
                    <d:var name="OcuDefaultThreshold" type="INTEGER" 
                           value="5000"/>
                    <d:var name="OcuHardwareTriggeredAdc" type="INTEGER" 
                           value="0">
                      <a:a name="ENABLE" value="false"/>
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuHardwareTriggeredDMA" type="INTEGER" 
                           value="0">
                      <a:a name="ENABLE" value="false"/>
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuMaxCounterValue" type="INTEGER" 
                           value="10000"/>
                    <d:var name="OcuNotification" type="FUNCTION-NAME" 
                           value="Ocu_Notification_channel_0">
                      <a:a name="ENABLE" value="false"/>
                    </d:var>
                    <d:var name="OcuOutputPinUsed" type="BOOLEAN" value="true"/>
                    <d:var name="OcuOutputPinDefaultState" type="ENUMERATION" 
                           value="OCU_LOW">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuOutputPinAction" type="ENUMERATION" 
                           value="OCU_TOGGLE"/>
                    <d:var name="OcuChannelTickDuration" type="INTEGER" 
                           value="1">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                  </d:ctr>
                  <d:ctr name="OcuChannel_1" type="IDENTIFIABLE">
                    <d:var name="OcuChannelId" type="INTEGER" value="1"/>
                    <d:var name="OcuAssignedHardwareChannel" type="INTEGER" 
                           value="1">
                      <a:a name="IMPORTER_INFO">
                        <a:v>@CALC</a:v>
                        <a:v>@DEF</a:v>
                      </a:a>
                    </d:var>
                    <d:ref name="OcuHWSpecificSettingsRef" type="REFERENCE" 
                           value="ASPath:/Ocu/Ocu/OcuConfigSet/OcuHWSpecificSettings_0"/>
                    <d:lst name="OcuChannelEcucPartitionRef">
                      <d:ref type="REFERENCE" 
                             value="ASPath:/EcuC/EcuC/EcucPartitionCollection/EcucPartition_1"/>
                    </d:lst>
                    <d:ref name="OcuHardwareChannelref" type="REFERENCE" 
                           value="ASPath:/Ocu/Ocu/OcuConfigSet/OcuFtu_1/OcuFtuChannels_0"/>
                    <d:var name="OcuDefaultThreshold" type="INTEGER" 
                           value="10000">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuHardwareTriggeredAdc" type="INTEGER" 
                           value="0">
                      <a:a name="ENABLE" value="false"/>
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuHardwareTriggeredDMA" type="INTEGER" 
                           value="0">
                      <a:a name="ENABLE" value="false"/>
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuMaxCounterValue" type="INTEGER" 
                           value="65535">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuNotification" type="FUNCTION-NAME" 
                           value="Ocu_Notification_channel_1">
                      <a:a name="ENABLE" value="false"/>
                    </d:var>
                    <d:var name="OcuOutputPinUsed" type="BOOLEAN" value="true"/>
                    <d:var name="OcuOutputPinDefaultState" type="ENUMERATION" 
                           value="OCU_LOW">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuOutputPinAction" type="ENUMERATION" 
                           value="OCU_TOGGLE"/>
                    <d:var name="OcuChannelTickDuration" type="INTEGER" 
                           value="1">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                  </d:ctr>
                </d:lst>
                <d:lst name="OcuHWSpecificSettings" type="MAP">
                  <d:ctr name="OcuHWSpecificSettings_0" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:var name="OcuClockSource" type="ENUMERATION" 
                           value="OCU_CLOCK_INTERNAL"/>
                    <d:var name="OcuPrescale" type="ENUMERATION" 
                           value="OCU_CLOCK_PRESCALER_DIV1"/>
                  </d:ctr>
                </d:lst>
                <d:lst name="OcuFtu" type="MAP">
                  <d:ctr name="OcuFtu_0" type="IDENTIFIABLE">
                    <d:var name="OcuFtuModule" type="ENUMERATION" value="FTU_0">
                      <a:a name="IMPORTER_INFO">
                        <a:v>@DEF</a:v>
                        <a:v>@CALC</a:v>
                      </a:a>
                    </d:var>
                    <d:var name="OcuFtuClockSource" type="ENUMERATION" 
                           value="OCU_FTU_BUS_CLK">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuFtuPrescale" type="ENUMERATION" 
                           value="OCU_FTU_PRESCALER_DIV1">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuFtuDebugMode" type="ENUMERATION" 
                           value="CNT_STOPED_FLAG_SET"/>
                    <d:lst name="OcuFtuChannels" type="MAP">
                      <d:ctr name="OcuFtuChannels_0" type="IDENTIFIABLE">
                        <d:var name="OcuFtuChannel" type="INTEGER" value="0">
                          <a:a name="IMPORTER_INFO">
                            <a:v>@DEF</a:v>
                            <a:v>@CALC</a:v>
                          </a:a>
                        </d:var>
                      </d:ctr>
                    </d:lst>
                  </d:ctr>
                  <d:ctr name="OcuFtu_1" type="IDENTIFIABLE">
                    <d:var name="OcuFtuModule" type="ENUMERATION" value="FTU_3"/>
                    <d:var name="OcuFtuClockSource" type="ENUMERATION" 
                           value="OCU_FTU_BUS_CLK">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuFtuPrescale" type="ENUMERATION" 
                           value="OCU_FTU_PRESCALER_DIV1">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="OcuFtuDebugMode" type="ENUMERATION" 
                           value="CNT_STOPED_FLAG_SET"/>
                    <d:lst name="OcuFtuChannels" type="MAP">
                      <d:ctr name="OcuFtuChannels_0" type="IDENTIFIABLE">
                        <d:var name="OcuFtuChannel" type="INTEGER" value="1"/>
                      </d:ctr>
                    </d:lst>
                  </d:ctr>
                </d:lst>
                <d:lst name="OcuEFtu" type="MAP"/>
                <d:lst name="OcuTpu" type="MAP"/>
              </d:ctr>
              <d:ctr name="OcuGeneral" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="OcuDevErrorDetect" type="BOOLEAN" value="true"/>
                <d:var name="OcuDisableRuntimeErrorDetect" type="BOOLEAN" 
                       value="false">
                  <a:a name="IMPORTER_INFO" value="@DEF"/>
                </d:var>
                <d:var name="OcuMulticoreSupport" type="BOOLEAN" value="true"/>
                <d:lst name="OcuEcucPartitionRef">
                  <d:ref type="REFERENCE" 
                         value="ASPath:/EcuC/EcuC/EcucPartitionCollection/EcucPartition_0"/>
                  <d:ref type="REFERENCE" 
                         value="ASPath:/EcuC/EcuC/EcucPartitionCollection/EcucPartition_1"/>
                </d:lst>
                <d:ref name="OcuKernelEcucPartitionRef" type="REFERENCE" >
                  <a:a name="ENABLE" value="false"/>
                </d:ref>
              </d:ctr>
              <d:ctr name="OcuConfigurationOfOptionalApis" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="OcuDeInitApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="OcuGetCounterApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="OcuNotificationSupported" type="BOOLEAN" 
                       value="true"/>
                <d:var name="OcuSetAbsoluteThresholdApi" type="BOOLEAN" 
                       value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="OcuSetPinActionApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="OcuSetPinStateApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="OcuSetRelativeThresholdApi" type="BOOLEAN" 
                       value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="OcuVersionInfoApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
              </d:ctr>
              <d:ctr name="CommonPublishedInformation" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="ArReleaseMajorVersion" type="INTEGER" value="4">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="ArReleaseMinorVersion" type="INTEGER" value="6">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="ArReleaseRevisionVersion" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="ModuleId" type="INTEGER" value="125">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="SwMajorVersion" type="INTEGER" value="1"/>
                <d:var name="SwMinorVersion" type="INTEGER" value="5"/>
                <d:var name="SwPatchVersion" type="INTEGER" value="1"/>
                <d:var name="VendorId" type="INTEGER" value="174">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
              </d:ctr>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
