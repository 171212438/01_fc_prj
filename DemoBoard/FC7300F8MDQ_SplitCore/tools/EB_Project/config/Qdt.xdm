    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="Qdt" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="Qdt" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <d:ctr type="MODULE-CONFIGURATION">
              <a:a name="DEF" value="ASPath:/FC7300FXXX/Qdt"/>
              <d:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" 
