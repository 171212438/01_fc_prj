#!gbuild
macro ProjectName=MCAL_FC7300F8MDQ_SplitCore_GHS_Demo
primaryTarget=arm_standalone.tgt
#component top_level_project
[Program]
	:postexec='gsrec -hex386 z_Build_${ProjectName}/bin/${ProjectName}.elf -o z_Build_${ProjectName}/bin/${ProjectName}.hex'
	-bsp generic
	-cpu=cortexm7
	-fsingle
	-fpu=vfpv5_d16
	-align8
	-littleendian
	-c99
	-G
	-Onone
	-Wundef
	--incorrect_pragma_warnings
	-Wimplicit-int
	-Wshadow
	-Wtrigraphs
	--unsigned_chars
	--unsigned_fields
	--no_commons
	--ghstd=last
	--no_exceptions
	--prototype_errors

	-keeptempfiles
	-list

	:sourceDir=.
	-object_dir=z_Build_${ProjectName}/objs
	-list_dir=z_Build_${ProjectName}/lst
	:outputDir=z_Build_${ProjectName}/output
	:binDir=z_Build_${ProjectName}/bin

	-DDEBUG
	-DRTT_PRINTF
	-DAUTOSAR_OS_NOT_USED
	-DUSE_SW_VECTOR_MODE
	-D__TARGET_USE_FPU

	-preprocess_assembly_files
	--gnu_asm
	-nostartfiles
	-e Reset_Handler_Core0
	-map
	-Mn
	-keepmap
	-delete
	-ignore_debug_references
	-dwarf2
	-overlap
	-paddr_offset=0
	{optgroup=GhsCommonOptions} -o ${ProjectName}.elf

	# Include Folder
	-I../../Include
	-I../../App/include
	-I../../_MCAL_multicore_generate_8M/include
	-I../../_BSW_generate/NvM/include
	-I../../_BSW_generate/Config
	-I../../_Compile_Related_Files/Common/Include
	-I../../_Compile_Related_Files/Systick/include
	-I../../_Compile_Related_Files/Det/include
	-I../../../../MCAL/Src/Adc/include
	-I../../../../MCAL/Src/Base/include
	-I../../../../MCAL/Src/Base/include/MemMap
	-I../../../../MCAL/Src/Can/include
	-I../../../../MCAL/Src/Common/include
	-I../../../../MCAL/Src/Crc/include
	-I../../../../MCAL/Src/Cryif/include
	-I../../../../MCAL/Src/Crypto/include
	-I../../../../MCAL/Src/Dem/include
	-I../../../../MCAL/Src/Dio/include
	-I../../../../MCAL/Src/DMA/include
	-I../../../../MCAL/Src/EcuM/include
	-I../../../../MCAL/Src/Eftu/include
	-I../../../../MCAL/Src/Eth/include
	-I../../../../MCAL/Src/EthIf/include
	-I../../../../MCAL/Src/EthTrcv/include
	-I../../../../MCAL/Src/EthSwt/include
	-I../../../../MCAL/Src/Fee/include
	-I../../../../MCAL/Src/Fls/include
	-I../../../../MCAL/Src/Gpt/include
	-I../../../../MCAL/Src/I2c/include
	-I../../../../MCAL/Src/Icu/include
	-I../../../../MCAL/Src/Lin/include
	-I../../../../MCAL/Src/LinIf
	-I../../../../MCAL/Src/Mb/include
	-I../../../../MCAL/Src/Mcu/include
	-I../../../../MCAL/Src/Msc/include
	-I../../../../MCAL/Src/Ocu/include
	-I../../../../MCAL/Src/Os/include
	-I../../../../MCAL/Src/Pfls/include
	-I../../../../MCAL/Src/Port/include
	-I../../../../MCAL/Src/Pwm/include
	-I../../../../MCAL/Src/Qdt/include
	-I../../../../MCAL/Src/SchM/include
	-I../../../../MCAL/Src/Sdadc/include
	-I../../../../MCAL/Src/Sent/include
	-I../../../../MCAL/Src/Spi/include
	-I../../../../MCAL/Src/Ssi/include
	-I../../../../MCAL/Src/TrgSel/include
	-I../../../../MCAL/Src/Uart/include
	-I../../../../MCAL/Src/Wdg/include
	-I../../../../MCAL/Src/WdgIf/include
	-I../../MiddleWare/RTT
	-I../../MiddleWare/UartDriver
	-I../../MiddleWare/Mpu

Startup\FC7300_8M.ld
Startup\FC7300_8M_core0.ld
Startup\FC7300_8M_core1.ld
Startup\FC7300_8M_core2.ld
Startup\FC7300_8M_core3.ld



#Subproject
_SubProjects\_BSW_generate.gpj
_SubProjects\_Compile_Related_Files.gpj
_SubProjects\_MCAL_multicore_generate_8M.gpj
_SubProjects\Include.gpj
_SubProjects\Source.gpj
_SubProjects\App.gpj
_SubProjects\MCAL.gpj
_SubProjects\MiddleWare.gpj
_SubProjects\Startup.gpj
