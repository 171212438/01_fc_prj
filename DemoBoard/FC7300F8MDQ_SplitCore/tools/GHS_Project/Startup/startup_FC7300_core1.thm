    .globl   Reset_Handler_Core1
    .weak    Reset_Handler_Core1
    .type    Reset_Handler_Core1, $function

Reset_Handler_Core1:
    cpsid   i               ; Mask interrupts

    ; Init the rest of the registers
    ldr     r1,=0
    ldr     r2,=0
    ldr     r3,=0
    ldr     r4,=0
    ldr     r5,=0
    ldr     r6,=0
    ldr     r7,=0
    mov     r8,r7
    mov     r9,r7
    mov     r10,r7
    mov     r11,r7
    mov     r12,r7

    ldr     r0, =0xE000ED08
    ldr     r1, =__rom_intvec_start_core1
    str     r1, [r0]
    ldr     r2, [r1]
    mov     r3, r2

    ; initialization startup stack, for ecc
    mov     r0, #0
    mov     r1, #0
    sub     r2, r2, #4

LoopClearStack:
    str     r0, [r2]
    sub     r2, r2, #4
    add     r1, r1, #1
    cmp     r1, #8
    bne     LoopClearStack

    msr     msp, r3

    ldr     r0, =system_init
    bx      r0

    .p2align 2
    .ltorg
    .size Reset_Handler_Core1, . - Reset_Handler_Core1
